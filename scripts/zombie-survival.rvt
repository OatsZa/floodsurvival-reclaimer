function trait_cost()
price = 0
scratch = current_player.perks
need = scratch
need &= Perk.fast
if need != 0 then price += 40 end
need = scratch
need &= Perk.slow
if need != 0 then price -= 30 end
need = scratch
need &= Perk.overshield
if need != 0 then price += 50 end
need = scratch
need &= Perk.frail
if need != 0 then price -= 40 end
need = scratch
need &= Perk.hard_hitter
if need != 0 then price += 40 end
need = scratch
need &= Perk.weak_arm
if need != 0 then price -= 30 end
need = scratch
need &= Perk.grenadier
if need != 0 then price += 30 end
need = scratch
need &= Perk.tough
if need != 0 then price += 40 end
need = scratch
need &= Perk.assault
if need != 0 then price += 50 end
limit = script_option[Option.free_shop]
if limit == 1 then price = 0 end
end

function draw_traits()
reset_cards()
trait_cost()
script_widget[5].set_text_for(current_player, "TRAITS  |  cost %n  |  you have %n points", price, current_player.points)
script_widget[17].set_text_for(current_player, "Ready: spawn")
script_widget[7].set_text_for(current_player, "Fast Feet: 25 percent faster  |  costs 40")
script_widget[8].set_text_for(current_player, "Slow: 10 percent slower  |  gives 30")
script_widget[9].set_text_for(current_player, "Overshield: double shields  |  costs 50")
script_widget[10].set_text_for(current_player, "Frail: no shields  |  gives 40")
script_widget[11].set_text_for(current_player, "Hard Hitter: 25 percent more damage  |  costs 40")
script_widget[12].set_text_for(current_player, "Weak Arm: less damage | gives 30")
script_widget[13].set_text_for(current_player, "Grenadier: 2 frags | costs 30")
script_widget[14].set_text_for(current_player, "Tough: more health | costs 40")
script_widget[19].set_text_for(current_player, "Assault: spawn with an Assault Rifle too  |  costs 50")
script_widget[19].set_color(current_player, 235, 240, 245, 255)
scratch = current_player.perks
need = scratch
need &= Perk.assault
if need != 0 then script_widget[19].set_color(current_player, 232, 184, 82, 255) end
need = scratch
need &= Perk.fast
if need != 0 then script_widget[7].set_color(current_player, 232, 184, 82, 255) end
need = scratch
need &= Perk.slow
if need != 0 then script_widget[8].set_color(current_player, 232, 184, 82, 255) end
need = scratch
need &= Perk.overshield
if need != 0 then script_widget[9].set_color(current_player, 232, 184, 82, 255) end
need = scratch
need &= Perk.frail
if need != 0 then script_widget[10].set_color(current_player, 232, 184, 82, 255) end
need = scratch
need &= Perk.hard_hitter
if need != 0 then script_widget[11].set_color(current_player, 232, 184, 82, 255) end
need = scratch
need &= Perk.weak_arm
if need != 0 then script_widget[12].set_color(current_player, 232, 184, 82, 255) end
need = scratch
need &= Perk.grenadier
if need != 0 then script_widget[13].set_color(current_player, 232, 184, 82, 255) end
need = scratch
need &= Perk.tough
if need != 0 then script_widget[14].set_color(current_player, 232, 184, 82, 255) end
end

function form_need()
need = 0
if class == ZsClass.brute or class == ZsClass.stalker then need = 1 end
if class == ZsClass.elite or class == ZsClass.nest_stalker then need = 2 end
if class >= ZsClass.turret_stalker then need = 3 end
if class >= ZsClass.sword_spartan then need = 0 end
end

function pick_form()
class = current_player.page
if class < ZsClass.human or class > ZsClass.spartan_boss then class = ZsClass.human end
if class > ZsClass.stalker and class < ZsClass.nest_stalker then class = ZsClass.human end
if class >= ZsClass.juggernaut then
if current_player != boss or boss_used == 1 then class = ZsClass.human end
end
ok = 0
scratch = phase_timer
if phase == Phase.intermission and scratch > 6 then ok = 1 end
if ok == 1 then class = ZsClass.monitor end
if ok == 0 and class == ZsClass.monitor then class = ZsClass.human end
end

function spawn_form()
pick_form()
form_need()
if class == ZsClass.monitor then need = 0 end
count = 1
if unlock < need then count = 0 end
limit = script_option[Option.wave_count]
if class == ZsClass.sword_spartan then
if phase != Phase.wave or wave < limit then count = 0 end
end
if count == 0 then script_widget[6].set_text_for(current_player, "That form is still locked") end
if count == 1 then
count = current_player.deploy_class(class)
if count == 0 then script_widget[6].set_text_for(current_player, "Can't take that form right now (Nest Stalker taken?)") end
if count == 1 then script_widget[6].set_text_for(current_player, "") end
if count == 1 and class >= ZsClass.juggernaut then boss_used = 1 end
end
end

function draw_picker()
reset_cards()
pick_form()
script_widget[5].set_text_for(current_player, "INFECTED  -  CHOOSE A FORM, THEN SPAWN")
script_widget[15].set_text_for(current_player, "Spawn")
script_widget[16].set_text_for(current_player, "Spawn at Nest")
script_widget[19].set_color(current_player, 235, 240, 245, 255)
script_widget[19].set_background(current_player, 15, 27, 39, 255)
script_widget[7].set_text_for(current_player, "Flood Human  |  tier 1")
script_widget[8].set_text_for(current_player, "Flood Brute  |  tier 2")
script_widget[9].set_text_for(current_player, "Flood Stalker  |  tier 2")
script_widget[10].set_text_for(current_player, "Flood Elite  |  tier 3  |  shields")
script_widget[11].set_text_for(current_player, "Nest Stalker  |  tier 3  |  builds the nest, 1 per team")
script_widget[12].set_text_for(current_player, "Turret Stalker | tier 4")
script_widget[13].set_text_for(current_player, "Tank Stalker | tier 4")
script_widget[14].set_text_for(current_player, "Flood Tank  |  tier 4")
script_widget[19].set_text_for(current_player, "Sword Spartan  |  last wave only")
if unlock < 3 then
limit = script_option[Option.tier_step_waves]
scratch = unlock
scratch += 1
limit *= scratch
limit += 1
scratch += 1
script_widget[5].set_text_for(current_player, "INFECTED  |  tier %n opens in wave %n", scratch, limit)
end
if unlock < 1 then
script_widget[8].set_color(current_player, 110, 118, 130, 255)
script_widget[9].set_color(current_player, 110, 118, 130, 255)
end
if unlock < 2 then
script_widget[10].set_color(current_player, 110, 118, 130, 255)
script_widget[11].set_color(current_player, 110, 118, 130, 255)
end
if unlock < 3 then
script_widget[12].set_color(current_player, 110, 118, 130, 255)
script_widget[13].set_color(current_player, 110, 118, 130, 255)
script_widget[14].set_color(current_player, 110, 118, 130, 255)
end
count = game.get_deployment_occupied(ZsClass.nest_stalker)
if unlock >= 2 and count > 0 then
script_widget[11].set_text_for(current_player, "Nest Stalker  |  taken")
script_widget[11].set_color(current_player, 110, 118, 130, 255)
end
limit = script_option[Option.wave_count]
if phase != Phase.wave or wave < limit then script_widget[19].set_color(current_player, 110, 118, 130, 255) end
if ok == 1 then
script_widget[5].set_text_for(current_player, "BREAK  -  YOU RISE AS A MONITOR")
script_widget[7].set_text_for(current_player, "Infected Monitor  |  flies, harmless  |  Flood again next wave")
end
if nest != no_object then
scratch = nest.health
script_widget[16].set_text_for(current_player, "Spawn at Nest (health %n)", scratch)
end
if class == ZsClass.human or class == ZsClass.monitor then script_widget[7].set_background(current_player, 45, 75, 105, 255) end
if class == ZsClass.brute then script_widget[8].set_background(current_player, 45, 75, 105, 255) end
if class == ZsClass.stalker then script_widget[9].set_background(current_player, 45, 75, 105, 255) end
if class == ZsClass.elite then script_widget[10].set_background(current_player, 45, 75, 105, 255) end
if class == ZsClass.nest_stalker then script_widget[11].set_background(current_player, 45, 75, 105, 255) end
if class == ZsClass.turret_stalker then script_widget[12].set_background(current_player, 45, 75, 105, 255) end
if class == ZsClass.tank_stalker then script_widget[13].set_background(current_player, 45, 75, 105, 255) end
if class == ZsClass.tank then script_widget[14].set_background(current_player, 45, 75, 105, 255) end
if class == ZsClass.sword_spartan then script_widget[19].set_background(current_player, 45, 75, 105, 255) end
script_widget[20].set_background(current_player, 60, 45, 15, 255)
script_widget[20].set_text_for(current_player, "BOSS  |  Juggernaut: giant Tank, 4x health  |  click to change")
if class >= ZsClass.juggernaut then script_widget[20].set_background(current_player, 120, 90, 30, 255) end
if class == ZsClass.brute_chieftain then script_widget[20].set_text_for(current_player, "BOSS  |  Brute Chieftain: giant, fastest, invincibility  |  click") end
if class == ZsClass.spartan_boss then script_widget[20].set_text_for(current_player, "BOSS  |  Spartan: invisible, sword, no headshots  |  click") end
end

function build_nest()
if nest == no_object and nest_wait.is_zero() then
nest = current_player.biped.place_at_me(flood_carrier, "zs_nest", never_garbage_collect, 5, 0, 0, shielded)
nest.copy_rotation_from(current_player.biped, false)
nest.set_scale(150)
nest.set_garbage_collection_disabled(true)
nest.max_health = 400
nest_wait = 30
nest_wait.set_rate(-100%)
end
end

function place_object()
count = 0
limit = script_option[Option.placeable_limit]
if current_player.pending == Item.turret then
for each object with label "zs_turret" do count += 1 end
end
if current_player.pending == Item.wall then
for each object with label "zs_wall" do count += 1 end
end
if current_player.pending == Item.plasma_cannon then
for each object with label "zs_plasma" do count += 1 end
end
if current_player.pending == Item.missile_pod then
for each object with label "zs_pod" do count += 1 end
end
if count >= limit then script_widget[6].set_text_for(current_player, "Your team already has %n of those: grav lift returned", count) end
if count < limit then
if current_player.pending == Item.turret then made = current_player.tool.place_at_me(machine_gun_emplacement, "zs_turret", none, 0, 0, 0, none) end
if current_player.pending == Item.wall then
made = current_player.tool.place_at_me(hunter, "zs_wall", never_garbage_collect, 0, 0, 0, none)
made.set_garbage_collection_disabled(true)
made.max_health = 300
end
if current_player.pending == Item.plasma_cannon then made = current_player.tool.place_at_me(plasma_cannon_emplacement, "zs_plasma", none, 0, 0, 0, none) end
if current_player.pending == Item.missile_pod then made = current_player.tool.place_at_me(missile_pod_emplacement, "zs_pod", none, 0, 0, 0, none) end
made.copy_rotation_from(current_player.biped, false)
current_player.pending = 0
script_widget[6].set_text_for(current_player, "Placed")
end
current_player.tool.delete()
current_player.tool = no_object
end

function purge()
for each object do
if current_object.is_of_type(vehicle) then
ok = 1
if current_object.has_forge_label("zs_turret") or current_object.has_forge_label("zs_plasma") then ok = 0 end
if current_object.has_forge_label("zs_pod") then ok = 0 end
if ok == 1 then
if current_object.is_of_type(plasma_cannon_emplacement) then avail |= 1 end
if current_object.is_of_type(missile_pod_emplacement) then avail |= 2 end
current_object.delete()
end
end
if current_object.is_of_type(weapon) and not current_object.has_forge_label("zs_gun") then
ok = 1
holder = current_object.get_carrier()
if holder != no_player then ok = 0 end
for each player do
if current_player.is_not_respawning() then
scratch = current_player.biped.get_distance_to(current_object)
if scratch < 6 then ok = 0 end
end
end
if ok == 1 then current_object.delete() end
end
end
end

function hide_menu()
script_widget[4].set_visibility(current_player, false)
script_widget[5].set_visibility(current_player, false)
script_widget[7].set_visibility(current_player, false)
script_widget[8].set_visibility(current_player, false)
script_widget[9].set_visibility(current_player, false)
script_widget[10].set_visibility(current_player, false)
script_widget[11].set_visibility(current_player, false)
script_widget[12].set_visibility(current_player, false)
script_widget[13].set_visibility(current_player, false)
script_widget[14].set_visibility(current_player, false)
script_widget[15].set_visibility(current_player, false)
script_widget[16].set_visibility(current_player, false)
script_widget[17].set_visibility(current_player, false)
script_widget[19].set_visibility(current_player, false)
script_widget[20].set_visibility(current_player, false)
end

on widget click: do
if current_player.menu == Menu.picker then
if clicked_widget == 7 then current_player.page = ZsClass.human end
if clicked_widget == 8 then current_player.page = ZsClass.brute end
if clicked_widget == 9 then current_player.page = ZsClass.stalker end
if clicked_widget == 10 then current_player.page = ZsClass.elite end
if clicked_widget == 11 then current_player.page = ZsClass.nest_stalker end
if clicked_widget == 12 then current_player.page = ZsClass.turret_stalker end
if clicked_widget == 13 then current_player.page = ZsClass.tank_stalker end
if clicked_widget == 14 then current_player.page = ZsClass.tank end
if clicked_widget == 19 then current_player.page = ZsClass.sword_spartan end
if clicked_widget == 20 then
scratch = current_player.page
current_player.page = ZsClass.juggernaut
if scratch == ZsClass.juggernaut then current_player.page = ZsClass.brute_chieftain end
if scratch == ZsClass.brute_chieftain then current_player.page = ZsClass.spartan_boss end
end
if clicked_widget == 15 then
current_player.set_primary_respawn_object(no_object)
spawn_form()
end
if clicked_widget == 16 and nest != no_object then
current_player.set_primary_respawn_object(nest)
spawn_form()
end
end
if current_player.menu == Menu.traits then
if clicked_widget >= 7 and clicked_widget <= 14 then
need = 1
count = clicked_widget
count -= 7
need <<= count
scratch = current_player.perks
scratch ^= need
if clicked_widget == 7 then scratch ~= Perk.slow end
if clicked_widget == 8 then scratch ~= Perk.fast end
if clicked_widget == 9 then scratch ~= Perk.frail end
if clicked_widget == 10 then scratch ~= Perk.overshield end
if clicked_widget == 11 then scratch ~= Perk.weak_arm end
if clicked_widget == 12 then scratch ~= Perk.hard_hitter end
current_player.perks = scratch
end
if clicked_widget == 19 then
scratch = current_player.perks
scratch ^= Perk.assault
current_player.perks = scratch
end
if clicked_widget == 17 then
trait_cost()
if current_player.points < price then script_widget[6].set_text_for(current_player, "Those traits cost %n: drop a boost or take a drawback", price) end
if current_player.points >= price then
current_player.points -= price
scratch = current_player.perks
scratch |= Perk.ready
current_player.perks = scratch
close_menu()
script_widget[6].set_text_for(current_player, "Traits set")
end
end
end
if current_player.menu == Menu.shop then
if clicked_widget >= 7 and clicked_widget <= 14 then
item = current_player.page
item *= 8
item += clicked_widget
item -= 7
ok = 1
if item > Item.missile_pod then ok = 0 end
if ok == 1 then buy() end
end
if clicked_widget == 15 then
current_player.page -= 1
if current_player.page < 0 then current_player.page = 3 end
end
if clicked_widget == 16 then
current_player.page += 1
if current_player.page > 3 then current_player.page = 0 end
end
if clicked_widget == 17 then close_menu() end
end
end

on button press: do
if pressed_button == button.equipment then
current_player.carrying = 0
if current_player.pending > 0 then
current_player.watch = 3
current_player.watch.set_rate(-100%)
end
end
if current_player.role == Role.survivor and current_player.is_not_respawning() then
if pressed_button == button.ability_1 then open_shop() end
end
class = current_player.get_deployment_class()
if current_player.is_not_respawning() then
if class == ZsClass.nest_stalker and pressed_button == button.ability_1 then build_nest() end
if class == ZsClass.turret_stalker or class == ZsClass.tank_stalker then
if pressed_button == button.ability_1 and current_player.morph_wait.is_zero() and current_player.morph_new == no_object and current_player.form <= 1 then
current_player.form += 2
current_player.morph_delay = 1
current_player.morph_delay.set_rate(-100%)
end
end
end
scratch = script_option[Option.test_keys]
if scratch == 1 and pressed_button == button.ability_4 then phase_timer = 0 end
end

players = 0
survivors = 0
infected = 0
for each player do
if current_player.role == Role.arrival then
current_player.role = Role.survivor
limit = script_option[Option.start_points]
current_player.points = limit
current_player.deaths = current_player.get_death_count()
current_player.kills = current_player.get_kill_count()
if wave >= 2 then make_infected() end
end
players += 1
if current_player.role == Role.survivor then survivors += 1 end
if current_player.role == Role.infected then infected += 1 end
end

if purge_timer.is_zero() then
purge()
purge_timer = 2
purge_timer.set_rate(-100%)
end

if phase == Phase.warmup then
limit = script_option[Option.min_players]
phase_timer.set_rate(-100%)
if players < limit then
phase_timer = script_option[Option.warmup_seconds]
phase_timer.set_rate(0%)
end
if players >= limit and phase_timer.is_zero() then
picks = players
need = script_option[Option.start_infected_percent]
picks *= need
picks += 99
picks /= 100
if picks < 1 then picks = 1 end
if picks >= players then
picks = players
picks -= 1
end
for each player randomly do
if picks > 0 and current_player.role == Role.survivor then
make_infected()
picks -= 1
infected += 1
survivors -= 1
end
end
converted = 0
wave = 1
start_wave()
end
end

if phase == Phase.wave and phase_timer.is_zero() then
limit = script_option[Option.wave_count]
if wave >= limit and survivors > 0 then
script_widget[0].set_text("The Survivors held out. SURVIVORS WIN")
team[0].end_round()
phase = Phase.over
end
if phase == Phase.wave then
limit = script_option[Option.wave_bonus]
for each player do
if current_player.role == Role.survivor then current_player.points += limit end
end
phase_timer = script_option[Option.break_seconds]
phase_timer.set_rate(-100%)
phase = Phase.intermission
boss = no_player
end
end

if phase == Phase.intermission and phase_timer.is_zero() then
wave += 1
start_wave()
boss = no_player
boss_used = 0
limit = 0
for each player do
scratch = current_player.get_kill_count()
if current_player.role == Role.infected and scratch > limit then
limit = scratch
boss = current_player
end
end
if boss != no_player then script_widget[6].set_text_for(boss, "You're the Juggernaut boss this wave: pick it when you next spawn") end
end

if phase == Phase.wave or phase == Phase.intermission then
if infected == 0 and players >= 2 then
for each player randomly do
if infected == 0 and current_player.role == Role.survivor then
make_infected()
infected += 1
survivors -= 1
end
end
end
if survivors == 0 and players > 0 then
script_widget[0].set_text("The Flood consumed every Survivor. INFECTED WIN")
team[1].end_round()
phase = Phase.over
end
end

for each player do
if current_player.swap == 2 and current_player.is_not_respawning() then current_player.biped.kill(false) end
if current_player.swap == 2 and not current_player.is_not_respawning() then current_player.swap = 0 end
if current_player.swap == 1 then current_player.swap = 2 end
class = current_player.get_deployment_class()
if phase == Phase.wave and class == ZsClass.monitor and current_player.is_not_respawning() and current_player.swap == 0 then current_player.swap = 1 end
if current_player.is_not_respawning() then
if class == ZsClass.monitor and current_player.swap == 0 then current_player.apply_traits(script_traits[0]) end
if class == ZsClass.human then current_player.apply_traits(script_traits[1]) end
if class == ZsClass.elite then current_player.apply_traits(script_traits[10]) end
if class == ZsClass.brute then current_player.apply_traits(script_traits[11]) end
if class == ZsClass.stalker then current_player.apply_traits(script_traits[12]) end
if class == ZsClass.tank_stalker and current_player.form == 0 then current_player.apply_traits(script_traits[12]) end
if class == ZsClass.nest_stalker then current_player.apply_traits(script_traits[2]) end
if class == ZsClass.turret_stalker or class == ZsClass.brute_chieftain then current_player.apply_traits(script_traits[13]) end
if class == ZsClass.spartan_boss then current_player.apply_traits(script_traits[14]) end
if class == ZsClass.sword_spartan then current_player.apply_traits(script_traits[11]) end
if current_player.role == Role.infected then
current_player.set_max_health(100)
if class == ZsClass.nest_stalker then current_player.set_max_health(150) end
if class == ZsClass.tank_stalker then current_player.set_max_health(125) end
if class == ZsClass.turret_stalker then current_player.set_max_health(75) end
if class == ZsClass.tank then current_player.set_max_health(200) end
if class == ZsClass.juggernaut then current_player.set_max_health(400) end
end
if current_player.form >= 2 and current_player.morph_delay.is_zero() and current_player.morph_new == no_object then
current_player.morph_old = current_player.biped
if current_player.form == 3 then current_player.morph_new = current_player.biped.place_at_me(flood_stalker, none, none, 0, 0, 0, none) end
if current_player.form == 2 and class == ZsClass.turret_stalker then current_player.morph_new = current_player.biped.place_at_me(flood_ranged, none, none, 0, 0, 0, none) end
if current_player.form == 2 and class == ZsClass.tank_stalker then current_player.morph_new = current_player.biped.place_at_me(flood_tank, none, none, 0, 0, 0, none) end
current_player.morph_new.kept = current_player.biped.health
current_player.set_biped(current_player.morph_new)
end
if current_player.morph_new != no_object then
current_player.morph_new.age += 1
if current_player.biped == current_player.morph_new then
current_player.morph_old.delete()
scratch = current_player.morph_new.kept
if scratch > 0 then current_player.morph_new.health = scratch end
scratch = current_player.form
current_player.form = 1
if scratch == 3 then current_player.form = 0 end
current_player.morph_new = no_object
current_player.morph_wait = 3
current_player.morph_wait.set_rate(-100%)
end
if current_player.morph_new != no_object then
scratch = current_player.morph_new.age
if scratch >= 30 then
current_player.morph_new.delete()
current_player.morph_new = no_object
current_player.form -= 2
end
end
end
if current_player.body != current_player.biped then
current_player.body = current_player.biped
if class == ZsClass.turret_stalker and current_player.form == 0 then current_player.biped.set_scale(75) end
if class == ZsClass.tank_stalker and current_player.form == 0 then current_player.biped.set_scale(125) end
if class == ZsClass.tank_stalker and current_player.form == 1 then current_player.biped.set_scale(120) end
if class == ZsClass.tank then current_player.biped.set_scale(150) end
if class == ZsClass.juggernaut then current_player.biped.set_scale(200) end
if class == ZsClass.brute_chieftain then
current_player.biped.set_scale(300)
current_player.give_equipment(invincibility)
end
end
end
if not current_player.is_not_respawning() and current_player.role == Role.infected then
current_player.form = 0
if current_player.morph_new != no_object then
current_player.morph_new.delete()
current_player.morph_new = no_object
end
end
if class == ZsClass.monitor then
current_player.set_vehicle_use(false)
current_player.set_turret_use(false)
end
if class >= ZsClass.survivor and class != ZsClass.monitor then
current_player.set_vehicle_use(true)
current_player.set_turret_use(true)
end
if current_player.role == Role.survivor then
current_player.set_max_shields(50)
if current_player.is_not_respawning() then
scratch = current_player.perks
need = scratch
need &= Perk.fast
if need != 0 then current_player.apply_traits(script_traits[2]) end
need = scratch
need &= Perk.slow
if need != 0 then current_player.apply_traits(script_traits[3]) end
need = scratch
need &= Perk.overshield
if need != 0 then current_player.apply_traits(script_traits[4]) end
need = scratch
need &= Perk.frail
if need != 0 then current_player.apply_traits(script_traits[5]) end
need = scratch
need &= Perk.hard_hitter
if need != 0 then current_player.apply_traits(script_traits[6]) end
need = scratch
need &= Perk.weak_arm
if need != 0 then current_player.apply_traits(script_traits[7]) end
need = scratch
need &= Perk.grenadier
if need != 0 then current_player.apply_traits(script_traits[8]) end
need = scratch
need &= Perk.tough
if need != 0 then current_player.apply_traits(script_traits[9]) end
end
end
if current_player.role == Role.infected then current_player.set_max_shields(100) end
scratch = current_player.get_death_count()
if scratch != current_player.deaths then
current_player.deaths = scratch
current_player.carrying = 0
ok = 1
if current_player.swap > 0 then
current_player.swap = 0
ok = 0
end
if ok == 1 and current_player.role == Role.survivor and phase != Phase.warmup then
make_infected()
converted += 1
end
end
scratch = current_player.get_kill_count()
scratch -= current_player.kills
current_player.kills = current_player.get_kill_count()
if scratch > 0 and current_player.role == Role.survivor then
limit = script_option[Option.kill_points]
scratch *= limit
current_player.points += scratch
end
if current_player.points > 100000 then current_player.points = 100000 end
if current_player.role == Role.survivor and current_player.team != team[0] then current_player.team = team[0] end
if current_player.role == Role.infected and current_player.team != team[1] then current_player.team = team[1] end
end

total = converted
total += survivors
if wave > 0 then
scratch = wave
scratch -= 1
need = script_option[Option.tier_step_waves]
scratch /= need
if scratch > 3 then scratch = 3 end
if scratch > unlock then unlock = scratch end
end

for each player do
class = current_player.get_deployment_class()
ok = 0
if current_player.role == Role.survivor and not current_player.is_not_respawning() and class == -1 and phase != Phase.over then
need = current_player.perks
need &= Perk.ready
if need != 0 then
count = ZsClass.survivor
scratch = current_player.perks
scratch &= Perk.grenadier
if scratch != 0 then count = ZsClass.grenadier end
scratch = current_player.perks
scratch &= Perk.assault
if scratch != 0 and count == ZsClass.grenadier then count = ZsClass.assault_grenadier end
if scratch != 0 and count == ZsClass.survivor then count = ZsClass.assault end
scratch = current_player.deploy_class(count)
end
if need == 0 then ok = 2 end
end
scratch = current_player.get_respawn_time()
if current_player.role == Role.infected and not current_player.is_not_respawning() and class == -1 and scratch == 0 and phase != Phase.over then ok = 1 end
if ok == 1 and current_player.menu == Menu.closed then
current_player.menu = Menu.picker
current_player.set_ui_menu(true)
end
if ok == 2 and current_player.menu == Menu.closed then
current_player.menu = Menu.traits
current_player.set_ui_menu(true)
end
if ok != 1 and current_player.menu == Menu.picker then close_menu() end
if ok != 2 and current_player.menu == Menu.traits then close_menu() end
if current_player.menu == Menu.shop and not current_player.is_not_respawning() then close_menu() end
end

if crate == no_object then
for each player do
if crate == no_object and current_player.role == Role.survivor and current_player.is_not_respawning() then
crate = current_player.biped.place_at_me(marine, "zs_crate", never_garbage_collect, 20, 0, 0, none)
crate.copy_rotation_from(current_player.biped, false)
crate.set_invincibility(true)
crate.set_garbage_collection_disabled(true)
end
end
end

if pulse.is_zero() then
limit = script_option[Option.crate_radius]
for each player do
if current_player.role == Role.survivor and current_player.is_not_respawning() and crate != no_object then
scratch = current_player.biped.get_distance_to(crate)
if scratch <= limit then current_player.refill_ammo() end
end
end
pulse.reset()
pulse.set_rate(-100%)
end

for each object do
if current_object.is_of_type(grav_lift) then current_object.age += 1 end
end
for each player do
if current_player.pending > 0 and current_player.is_not_respawning() then
if current_player.tool == no_object and not current_player.watch.is_zero() then
made = no_object
limit = 100000
for each object do
if current_object.is_of_type(grav_lift) and current_object.claimed == 0 and current_object.age < 90 then
scratch = current_object.get_distance_to(current_player.biped)
if scratch < limit then
limit = scratch
made = current_object
end
end
end
if made != no_object then
made.claimed = 1
current_player.tool = made
end
end
if current_player.tool != no_object then
scratch = current_player.tool.get_speed()
count = current_player.tool.age
if scratch == 0 and count >= 5 then place_object() end
end
if current_player.carrying.is_zero() and current_player.watch.is_zero() and current_player.tool == no_object and current_player.pending > 0 then
current_player.give_equipment(grav_lift)
current_player.carrying = 1
end
end
end

seconds = phase_timer
limit = script_option[Option.min_players]
if phase == Phase.warmup then
script_widget[0].set_text("WARMUP  |  outbreak in %n s", seconds)
if players < limit then script_widget[0].set_text("ZOMBIE SURVIVAL  |  waiting for %n players", limit) end
end
if phase == Phase.wave then
limit = script_option[Option.wave_count]
script_widget[0].set_text("WAVE %n / %n  |  %n s left", wave, limit, seconds)
end
if phase == Phase.intermission then
scratch = wave
scratch += 1
script_widget[0].set_text("BREAK  |  wave %n starts in %n s  |  arsenal open anywhere", scratch, seconds)
end
script_widget[1].set_text("Survivors %n  |  Infected %n  |  Flood forms unlocked %n / 3", survivors, infected, unlock)
script_widget[0].set_visibility(all_players, true)
script_widget[1].set_visibility(all_players, true)
script_widget[6].set_visibility(all_players, true)

for each player do
script_widget[18].set_visibility(current_player, false)
if current_player.role == Role.survivor then
script_widget[2].set_text_for(current_player, "%n points", current_player.points)
limit = script_option[Option.free_shop]
if limit == 1 then script_widget[2].set_text_for(current_player, "%n points  |  test mode: the arsenal is FREE", current_player.points) end
script_widget[3].set_text_for(current_player, "Ability 1: arsenal")
if current_player.pending == Item.turret then script_widget[3].set_text_for(current_player, "Your next grav lift becomes: Machine Gun Emplacement") end
if current_player.pending == Item.wall then script_widget[3].set_text_for(current_player, "Your next grav lift becomes: Barrier (Hunter)") end
if current_player.pending == Item.plasma_cannon then script_widget[3].set_text_for(current_player, "Your next grav lift becomes: Plasma Cannon") end
if current_player.pending == Item.missile_pod then script_widget[3].set_text_for(current_player, "Your next grav lift becomes: Missile Pod") end
if phase == Phase.wave and crate != no_object and current_player.is_not_respawning() then
scratch = current_player.biped.get_distance_to(crate)
limit = script_option[Option.crate_radius]
script_widget[18].set_text_for(current_player, "Crate %n ft away  |  arsenal and ammo within %n ft", scratch, limit)
script_widget[18].set_visibility(current_player, true)
end
end
if current_player.role == Role.infected then
script_widget[2].set_text_for(current_player, "Survivors converted: %n of %n", converted, total)
script_widget[3].set_text_for(current_player, "Infected: hunt the Survivors down")
class = current_player.get_deployment_class()
if class == ZsClass.monitor then script_widget[3].set_text_for(current_player, "Monitor: you rise as Flood when the next wave starts") end
if class == ZsClass.nest_stalker then
scratch = nest_wait
script_widget[3].set_text_for(current_player, "Nest Stalker  |  A1 build the nest (ready in %n s)", scratch)
if nest != no_object then script_widget[3].set_text_for(current_player, "Nest Stalker  |  your team's nest is standing") end
end
scratch = current_player.morph_wait
if class == ZsClass.turret_stalker then script_widget[3].set_text_for(current_player, "Turret Stalker  |  A1 turret form on / off (ready in %n s)", scratch) end
if class == ZsClass.tank_stalker then script_widget[3].set_text_for(current_player, "Tank Stalker  |  A1 Tank form on / off (ready in %n s)", scratch) end
end
script_widget[2].set_visibility(current_player, true)
script_widget[3].set_visibility(current_player, true)
hide_menu()
if current_player.menu == Menu.shop or current_player.menu == Menu.traits then
if current_player.menu == Menu.shop then draw_shop() end
if current_player.menu == Menu.traits then draw_traits() end
script_widget[4].set_visibility(current_player, true)
script_widget[5].set_visibility(current_player, true)
script_widget[7].set_visibility(current_player, true)
script_widget[8].set_visibility(current_player, true)
script_widget[9].set_visibility(current_player, true)
script_widget[10].set_visibility(current_player, true)
if current_player.menu == Menu.traits or current_player.page != 3 then
script_widget[11].set_visibility(current_player, true)
script_widget[12].set_visibility(current_player, true)
script_widget[13].set_visibility(current_player, true)
script_widget[14].set_visibility(current_player, true)
end
if current_player.menu == Menu.shop then
script_widget[15].set_visibility(current_player, true)
script_widget[16].set_visibility(current_player, true)
end
if current_player.menu == Menu.traits then script_widget[19].set_visibility(current_player, true) end
script_widget[17].set_visibility(current_player, true)
end
if current_player.menu == Menu.picker then
draw_picker()
script_widget[4].set_visibility(current_player, true)
script_widget[5].set_visibility(current_player, true)
script_widget[7].set_visibility(current_player, true)
script_widget[15].set_visibility(current_player, true)
if ok == 0 then
script_widget[8].set_visibility(current_player, true)
script_widget[9].set_visibility(current_player, true)
script_widget[10].set_visibility(current_player, true)
script_widget[11].set_visibility(current_player, true)
script_widget[12].set_visibility(current_player, true)
script_widget[13].set_visibility(current_player, true)
script_widget[14].set_visibility(current_player, true)
script_widget[19].set_visibility(current_player, true)
if current_player == boss and boss_used == 0 then script_widget[20].set_visibility(current_player, true) end
end
if nest != no_object then script_widget[16].set_visibility(current_player, true) end
end
end
