script_widget[10].set_visibility(current_player, false)
script_widget[11].set_visibility(current_player, false)
script_widget[12].set_visibility(current_player, false)
script_widget[13].set_visibility(current_player, false)
script_widget[14].set_visibility(current_player, false)
script_widget[15].set_visibility(current_player, false)
script_widget[16].set_visibility(current_player, false)
script_widget[17].set_visibility(current_player, false)
script_widget[19].set_visibility(current_player, false)
script_widget[20].set_visibility(current_player, false)
script_widget[24].set_visibility(current_player, false)
script_widget[25].set_visibility(current_player, false)
script_widget[26].set_visibility(current_player, false)
script_widget[21].set_visibility(current_player, false)
script_widget[27].set_visibility(current_player, false)
script_widget[28].set_visibility(current_player, false)
script_widget[29].set_visibility(current_player, false)
script_widget[30].set_visibility(current_player, false)
script_widget[31].set_visibility(current_player, false)
end

on widget click: do
if current_player.menu == Menu.picker then
if clicked_widget == 7 then current_player.page = ZsClass.human end
if clicked_widget == 8 then current_player.page = ZsClass.baby_stalker end
if clicked_widget == 9 then current_player.page = ZsClass.breacher end
if clicked_widget == 10 then current_player.page = ZsClass.brute end
if clicked_widget == 11 then current_player.page = ZsClass.stalker end
if clicked_widget == 12 then current_player.page = ZsClass.jumper_brute end
if clicked_widget == 13 then current_player.page = ZsClass.elite end
if clicked_widget == 14 then current_player.page = ZsClass.nest_stalker end
if clicked_widget == 19 then current_player.page = ZsClass.invis_stalker end
if clicked_widget == 24 then current_player.page = ZsClass.shifter_stalker end
if clicked_widget == 25 then current_player.page = ZsClass.tank end
if clicked_widget == 26 then current_player.page = ZsClass.sword_spartan end
if clicked_widget == 20 then
scratch = current_player.page
current_player.page = ZsClass.juggernaut
if scratch == ZsClass.juggernaut then current_player.page = ZsClass.brute_chieftain end
if scratch == ZsClass.brute_chieftain then current_player.page = ZsClass.spartan_boss end
end
if clicked_widget == 15 then
current_player.set_primary_respawn_object(no_object)
spawn_form()
end
if clicked_widget == 16 and nest != no_object then
current_player.set_primary_respawn_object(nest)
spawn_form()
end
end
if current_player.menu == Menu.traits then
if clicked_widget >= 7 and clicked_widget <= 14 then
need = 1
count = clicked_widget
count -= 7
need <<= count
scratch = current_player.perks
scratch ^= need
if clicked_widget == 7 then scratch ~= Perk.slow end
if clicked_widget == 8 then scratch ~= Perk.fast end
if clicked_widget == 9 then scratch ~= Perk.frail end
if clicked_widget == 10 then scratch ~= Perk.overshield end
if clicked_widget == 11 then scratch ~= Perk.weak_arm end
if clicked_widget == 12 then scratch ~= Perk.hard_hitter end
current_player.perks = scratch
end
if clicked_widget == 19 then
scratch = current_player.perks
scratch ^= Perk.assault
current_player.perks = scratch
end
if clicked_widget == 17 then
trait_cost()
if current_player.points < price then script_widget[6].set_text_for(current_player, "Not enough points: that costs %n", price) end
if current_player.points >= price then
current_player.points -= price
scratch = current_player.perks
scratch |= Perk.ready
current_player.perks = scratch
close_menu()
script_widget[6].set_text_for(current_player, "Traits set")
end
end
end
if current_player.menu == Menu.shop then
if clicked_widget >= 7 and clicked_widget <= 14 then
item = current_player.page
item *= 8
item += clicked_widget
item -= 7
ok = 1
if item > Item.missile_pod and item < Item.ammo then ok = 0 end
if ok == 1 then buy() end
end
if clicked_widget == 15 then
current_player.page -= 1
if current_player.page < 0 then current_player.page = 3 end
end
if clicked_widget == 16 then
current_player.page += 1
if current_player.page > 3 then current_player.page = 0 end
end
if clicked_widget == 17 then close_menu() end
end
end

on button press: do
if pressed_button == button.equipment then
current_player.carrying = 0
if current_player.pending > 0 then
current_player.watch = 3
current_player.watch.set_rate(-100%)
end
end
if current_player.role == Role.survivor and current_player.is_not_respawning() then
if pressed_button == button.ability_1 then open_shop() end
if pressed_button == button.flashlight then
ok = 0
if current_player.prop != no_object then ok = 1 end
if ok == 1 then
for each object do
if current_object.is_of_type(biped) and current_object != current_player.biped then
scratch = current_object.get_distance_to(current_player.prop)
if scratch < 5 then ok = 2 end
end
end
if ok == 2 then script_widget[6].set_text_for(current_player, "Too close to someone: props can't be dropped within 4 ft") end
end
if ok == 1 then
current_player.prop.detach()
current_player.prop.copy_rotation_from(current_player.biped, false)
current_player.prop.prop_owner = current_player
current_player.prop.prop_lock = 5
current_player.prop.prop_lock.set_rate(-100%)
scratch = current_player.prop.counted_wave
if scratch != open_wave then current_player.biped.wave_props += 1 end
current_player.prop.counted_wave = open_wave
current_player.prop = no_object
if current_player.pending == Item.prop then
current_player.pending = 0
current_player.give_equipment(none)
current_player.carrying = 0
end
script_widget[6].set_text_for(current_player, "Placed")
end
if ok == 0 then
made = no_object
limit = 9
need = 0
for each object do
ok = 1
if current_object.is_of_type(biped) or current_object.is_of_type(vehicle) then ok = 0 end
if current_object.is_of_type(weapon) or current_object.is_of_type(equipment) then ok = 0 end
holder = current_object.get_carrier()
if holder != no_player then ok = 0 end
if ok == 1 then
scratch = current_object.get_distance_to(current_player.biped)
if current_object.prop_owner != current_player and not current_object.prop_lock.is_zero() then
if scratch < 9 then need = 1 end
scratch = 100
end
if scratch < limit then
limit = scratch
made = current_object
end
end
end
if made == no_object then script_widget[6].set_text_for(current_player, "No prop within 8 ft") end
if made == no_object and need == 1 then script_widget[6].set_text_for(current_player, "Someone just placed that prop: wait a few seconds") end
if made != no_object then
current_player.prop = made
made.attach_to(current_player.biped, 5, 0, 2, relative)
script_widget[6].set_text_for(current_player, "Picked up a prop %n ft away", limit)
scratch = current_player.perks
scratch &= Perk.prop_placer
if scratch != 0 and current_player.carrying.is_zero() and current_player.pending == 0 then
current_player.pending = Item.prop
current_player.give_equipment(grav_lift)
current_player.carrying = 1
end
end
end
end
end
class = current_player.get_deployment_class()
if current_player.is_not_respawning() then
if pressed_button == button.crouch then
ok = 0
if class == ZsClass.human or class == ZsClass.breacher or class == ZsClass.elite then ok = 1 end
if class == ZsClass.brute or class == ZsClass.jumper_brute then ok = 1 end
if ok == 1 and current_player.biped.leap_state == 0 and current_player.biped.leap_wait.is_zero() then
current_player.biped.leap_state = 1
current_player.biped.leap_wait = 1
current_player.biped.leap_wait.set_rate(-200%)
end
end
if class == ZsClass.nest_stalker and pressed_button == button.ability_1 then build_nest() end
if class == ZsClass.shifter_stalker and current_player.morph_wait.is_zero() and current_player.morph_new == no_object and current_player.form <= 1 then
ok = 0
if pressed_button == button.ability_1 or pressed_button == button.ability_2 then ok = 1 end
if ok == 1 and current_player.form == 0 then
scratch = current_player.perks
scratch ~= Perk.shift_tank
if pressed_button == button.ability_2 then scratch |= Perk.shift_tank end
current_player.perks = scratch
end
if ok == 1 then
current_player.form += 2
current_player.morph_delay = 1
current_player.morph_delay.set_rate(-100%)
end
end
end
scratch = script_option[Option.test_keys]
if scratch == 1 and pressed_button == button.ability_4 then phase_timer = 0 end
end

players = 0
survivors = 0
infected = 0
for each player do
if current_player.role == Role.arrival then
current_player.role = Role.survivor
limit = script_option[Option.start_points]
current_player.points = limit
current_player.deaths = current_player.get_death_count()
current_player.kills = current_player.get_kill_count()
if wave >= 2 then make_infected() end
end
players += 1
if current_player.role == Role.survivor then survivors += 1 end
if current_player.role == Role.infected then infected += 1 end
end

if purge_timer.is_zero() then
purge()
purge_timer = 2
purge_timer.set_rate(-100%)
end

if phase == Phase.warmup then
limit = script_option[Option.min_players]
phase_timer.set_rate(-100%)
if players < limit then
phase_timer = script_option[Option.warmup_seconds]
phase_timer.set_rate(0%)
end
if players >= limit and phase_timer.is_zero() then
picks = players
need = script_option[Option.start_infected_percent]
picks *= need
picks += 99
picks /= 100
if picks < 1 then picks = 1 end
if picks >= players then
picks = players
picks -= 1
end
for each player randomly do
if picks > 0 and current_player.role == Role.survivor then
make_infected()
picks -= 1
infected += 1
survivors -= 1
end
end
converted = 0
wave = 1
start_wave()
end
end

if phase == Phase.wave and phase_timer.is_zero() then
limit = script_option[Option.wave_count]
if wave >= limit and survivors > 0 then
script_widget[0].set_text("The Survivors held out. SURVIVORS WIN")
team[0].end_round()
phase = Phase.over
end
if phase == Phase.wave then
limit = script_option[Option.wave_bonus]
for each player do
if current_player.role == Role.survivor then current_player.points += limit end
end
top_killer = no_player
top_builder = no_player
count = 0
need = 0
for each player randomly do
if current_player.role == Role.survivor and current_player.is_not_respawning() then
scratch = current_player.biped.wave_kills
if scratch > count then
count = scratch
top_killer = current_player
end
scratch = current_player.biped.wave_props
if scratch > need then
need = scratch
top_builder = current_player
end
current_player.biped.wave_kills = 0
current_player.biped.wave_props = 0
end
end
for each player do
script_widget[6].set_text_for(current_player, "Wave %n awards: most kills %n, most props placed %n", wave, count, need)
scratch = current_player.perks
if current_player == top_killer then
scratch |= Perk.free_gun
script_widget[6].set_text_for(current_player, "WAVE AWARD: most kills (%n). Your next weapon is free, any you like", count)
end
if current_player == top_builder then
scratch |= Perk.free_gear
script_widget[6].set_text_for(current_player, "WAVE AWARD: most props placed (%n). Next placeable or equipment is free", need)
end
if current_player == top_killer and current_player == top_builder then script_widget[6].set_text_for(current_player, "WAVE AWARDS: most kills and most props. Next weapon and next gear are free") end
current_player.perks = scratch
end
phase_timer = script_option[Option.break_seconds]
phase_timer.set_rate(-100%)
phase = Phase.intermission
boss = no_player
card_rows()
end
end

if phase == Phase.intermission and phase_timer.is_zero() then
wave += 1
start_wave()
boss = no_player
boss_used = 0
limit = -1
for each player randomly do
scratch = current_player.get_kill_count()
if current_player.role == Role.infected and scratch > limit then
limit = scratch
boss = current_player
end
end
if boss != no_player then
script_widget[6].set_text_for(boss, "You're this wave's boss: pick a boss card")
script_widget[4].set_size(boss, 900, 560)
script_widget[20].set_position(boss, 210, 165)
script_widget[20].set_size(boss, 860, 48)
script_widget[7].set_position(boss, 210, 219)
script_widget[8].set_position(boss, 650, 219)
script_widget[9].set_position(boss, 210, 273)
script_widget[10].set_position(boss, 650, 273)
script_widget[11].set_position(boss, 210, 327)
script_widget[12].set_position(boss, 650, 327)
script_widget[13].set_position(boss, 210, 381)
script_widget[14].set_position(boss, 650, 381)
script_widget[19].set_position(boss, 210, 435)
script_widget[24].set_position(boss, 650, 435)
script_widget[25].set_position(boss, 210, 489)
script_widget[26].set_position(boss, 650, 489)
script_widget[15].set_position(boss, 210, 575)
script_widget[16].set_position(boss, 430, 575)
end
end

if phase == Phase.wave or phase == Phase.intermission then
if infected == 0 and players >= 2 then
for each player randomly do
if infected == 0 and current_player.role == Role.survivor then
make_infected()
infected += 1
survivors -= 1
end
end
end
if survivors == 0 and players > 0 then
script_widget[0].set_text("The Flood consumed every Survivor. INFECTED WIN")
team[1].end_round()
phase = Phase.over
end
if survivors == 1 and last_alert == 0 then
last_alert = 1
team[0].set_color(232, 184, 82)
script_widget[1].set_color(all_players, 232, 184, 82, 255)
for each player do
script_widget[6].set_text_for(current_player, "One Survivor left: hunt them down")
if current_player.role == Role.survivor then script_widget[6].set_text_for(current_player, "You're the last Survivor: 2x health, bottomless mag, fast shields") end
end
end
end

for each player do
if current_player.swap == 2 and current_player.is_not_respawning() then current_player.biped.kill(false) end
if current_player.swap == 2 and not current_player.is_not_respawning() then current_player.swap = 0 end
if current_player.swap == 1 then current_player.swap = 2 end
class = current_player.get_deployment_class()
if phase == Phase.wave and class == ZsClass.monitor and current_player.is_not_respawning() and current_player.swap == 0 then current_player.swap = 1 end
if current_player.is_not_respawning() then
if class == ZsClass.monitor and current_player.swap == 0 then current_player.apply_traits(script_traits[0]) end
if class == ZsClass.human then current_player.apply_traits(script_traits[1]) end
if class == ZsClass.elite then current_player.apply_traits(script_traits[10]) end
if class == ZsClass.brute then current_player.apply_traits(script_traits[11]) end
if class == ZsClass.stalker then current_player.apply_traits(script_traits[12]) end
if class == ZsClass.shifter_stalker and current_player.form == 0 then current_player.apply_traits(script_traits[12]) end
if class == ZsClass.jumper_brute then current_player.apply_traits(script_traits[12]) end
if class == ZsClass.breacher then current_player.apply_traits(script_traits[1]) end
if class == ZsClass.nest_stalker then current_player.apply_traits(script_traits[2]) end
if class == ZsClass.brute_chieftain or class == ZsClass.baby_stalker or class == ZsClass.invis_stalker then current_player.apply_traits(script_traits[13]) end
if class == ZsClass.spartan_boss then current_player.apply_traits(script_traits[14]) end
if class == ZsClass.sword_spartan then current_player.apply_traits(script_traits[11]) end
if current_player.role == Role.infected then
current_player.set_max_health(100)
if class == ZsClass.human then current_player.set_max_health(200) end
if class == ZsClass.nest_stalker then current_player.set_max_health(150) end
if class == ZsClass.baby_stalker then current_player.set_max_health(40) end
if class == ZsClass.breacher then current_player.set_max_health(300) end
if class == ZsClass.invis_stalker then current_player.set_max_health(85) end
scratch = current_player.perks
scratch &= Perk.shift_tank
if class == ZsClass.shifter_stalker and current_player.form == 1 and scratch != 0 then current_player.set_max_health(125) end
if class == ZsClass.tank then current_player.set_max_health(200) end
if class == ZsClass.juggernaut then current_player.set_max_health(400) end
if class == ZsClass.brute_chieftain then current_player.set_max_health(300) end
end
if current_player.role == Role.infected then
scratch = current_player.biped.leap_state
if scratch == 1 and current_player.biped.leap_wait.is_zero() then
made = current_player.biped.place_at_me(magnum, "zs_leap", none, 0, 0, 20, none)
made.set_hidden(true)
current_player.biped.leap_origin = made
made = current_player.biped.place_at_me(magnum, "zs_leap", none, 30, 0, 20, none)
made.set_hidden(true)
current_player.biped.leap_origin.leap_ahead = made
made = current_player.biped.place_at_me(magnum, "zs_leap", none, 0, 0, 20, none)
made.set_hidden(true)
made.set_velocity(30, 0, 0)
current_player.biped.leap_origin.leap_px = made
made = current_player.biped.place_at_me(magnum, "zs_leap", none, 0, 0, 20, none)
made.set_hidden(true)
made.set_velocity(0, 30, 0)
current_player.biped.leap_origin.leap_py = made
current_player.biped.leap_ticks = 0
current_player.biped.leap_state = 5
end
if scratch == 5 then
current_player.biped.leap_ticks += 1
if current_player.biped.leap_ticks >= 3 then
leap_helper = current_player.biped.leap_origin
leap_r = leap_helper.get_distance_to(leap_helper.leap_ahead)
leap_s = leap_helper.get_distance_to(leap_helper.leap_px)
leap_d = leap_helper.leap_ahead.get_distance_to(leap_helper.leap_px)
leap_cosine()
current_player.biped.leap_cos = leap_num
leap_r = leap_helper.get_distance_to(leap_helper.leap_ahead)
leap_s = leap_helper.get_distance_to(leap_helper.leap_py)
leap_d = leap_helper.leap_ahead.get_distance_to(leap_helper.leap_py)
leap_cosine()
leap_fwd = 9
leap_up = 6
if class == ZsClass.brute or class == ZsClass.elite then
leap_fwd = 10
leap_up = 6
end
if class == ZsClass.jumper_brute then
leap_fwd = 15
leap_up = 8
end
leap_s = leap_fwd
leap_s *= current_player.biped.leap_cos
leap_s /= 100
leap_d = leap_fwd
leap_d *= leap_num
leap_d /= 100
current_player.biped.set_velocity(leap_s, leap_d, leap_up)
leap_helper.leap_ahead.delete()
leap_helper.leap_px.delete()
leap_helper.leap_py.delete()
leap_helper.delete()
current_player.biped.leap_state = 2
current_player.biped.leap_wait = 2
current_player.biped.leap_wait.set_rate(-100%)
end
end
if scratch == 2 and current_player.biped.leap_wait.is_zero() then current_player.biped.leap_state = 0 end
end
if current_player.role == Role.infected and current_player.form >= 2 and current_player.morph_delay.is_zero() and current_player.morph_new == no_object then
current_player.morph_old = current_player.biped
if current_player.form == 3 then current_player.morph_new = current_player.biped.place_at_me(flood_stalker, none, none, 0, 0, 0, none) end
scratch = current_player.perks
scratch &= Perk.shift_tank
if current_player.form == 2 and class == ZsClass.shifter_stalker and scratch == 0 then current_player.morph_new = current_player.biped.place_at_me(flood_ranged, none, none, 0, 0, 0, none) end
if current_player.form == 2 and class == ZsClass.shifter_stalker and scratch != 0 then current_player.morph_new = current_player.biped.place_at_me(flood_tank, none, none, 0, 0, 0, none) end
current_player.morph_new.kept = current_player.biped.health
current_player.set_biped(current_player.morph_new)
end
if current_player.morph_new != no_object then
current_player.morph_new.age += 1
if current_player.biped == current_player.morph_new then
current_player.morph_old.delete()
scratch = current_player.morph_new.kept
if scratch > 0 then current_player.morph_new.health = scratch end
scratch = current_player.form
current_player.form = 1
if scratch == 3 then current_player.form = 0 end
current_player.morph_new = no_object
current_player.morph_wait = 3
current_player.morph_wait.set_rate(-100%)
end
if current_player.morph_new != no_object then
scratch = current_player.morph_new.age
if scratch >= 30 then
current_player.morph_new.delete()
current_player.morph_new = no_object
current_player.form -= 2
end
end
end
if current_player.body != current_player.biped then
current_player.body = current_player.biped
scratch = current_player.perks
scratch &= Perk.shift_tank
if class == ZsClass.shifter_stalker and current_player.form == 1 and scratch != 0 then current_player.biped.set_scale(120) end
if class == ZsClass.baby_stalker then current_player.biped.set_scale(50) end
if class == ZsClass.breacher then current_player.biped.set_scale(130) end
if class == ZsClass.invis_stalker then current_player.biped.set_scale(85) end
if class == ZsClass.tank then current_player.biped.set_scale(150) end
if class == ZsClass.juggernaut then current_player.biped.set_scale(200) end
if class == ZsClass.brute_chieftain then
current_player.biped.set_scale(300)
current_player.give_equipment(invincibility)
end
end
end
if not current_player.is_not_respawning() and current_player.role == Role.infected then
current_player.form = 0
scratch = current_player.perks
scratch &= 1023
current_player.perks = scratch
if current_player.morph_new != no_object then
current_player.morph_new.delete()
current_player.morph_new = no_object
end
end
if class == ZsClass.monitor then
current_player.set_vehicle_use(false)
current_player.set_turret_use(false)
end
if class >= ZsClass.survivor and class != ZsClass.monitor then
current_player.set_vehicle_use(true)
current_player.set_turret_use(true)
end
if current_player.role == Role.survivor then
current_player.set_max_shields(50)
if current_player.is_not_respawning() then
scratch = current_player.perks
need = scratch
need &= Perk.fast
if need != 0 then current_player.apply_traits(script_traits[2]) end
need = scratch
need &= Perk.slow
if need != 0 then current_player.apply_traits(script_traits[3]) end
need = scratch
need &= Perk.overshield
if need != 0 then current_player.apply_traits(script_traits[4]) end
need = scratch
need &= Perk.frail
if need != 0 then current_player.apply_traits(script_traits[5]) end
need = scratch
need &= Perk.hard_hitter
if need != 0 then current_player.apply_traits(script_traits[6]) end
need = scratch
need &= Perk.weak_arm
if need != 0 then current_player.apply_traits(script_traits[7]) end
need = scratch
need &= Perk.grenadier
if need != 0 then current_player.apply_traits(script_traits[8]) end
need = scratch
need &= Perk.tough
if need != 0 then current_player.apply_traits(script_traits[9]) end
if survivors == 1 and phase >= Phase.wave then
current_player.apply_traits(script_traits[15])
current_player.set_max_health(200)
end
end
end
if current_player.role == Role.infected then current_player.set_max_shields(100) end
scratch = current_player.get_death_count()
if scratch != current_player.deaths then
current_player.deaths = scratch
current_player.carrying = 0
if current_player.role == Role.survivor then drop_prop() end
ok = 1
if current_player.swap > 0 then
current_player.swap = 0
ok = 0
end
if ok == 1 and current_player.role == Role.survivor and phase != Phase.warmup then
make_infected()
converted += 1
end
end
scratch = current_player.get_kill_count()
scratch -= current_player.kills
current_player.kills = current_player.get_kill_count()
if scratch > 0 and current_player.role == Role.survivor then
if current_player.biped != no_object then current_player.biped.wave_kills += scratch end
limit = script_option[Option.kill_points]
scratch *= limit
current_player.points += scratch
end
if current_player.points > 100000 then current_player.points = 100000 end
if current_player.role == Role.survivor and current_player.team != team[0] then current_player.team = team[0] end
if current_player.role == Role.infected and current_player.team != team[1] then current_player.team = team[1] end
end

total = converted
total += survivors
if wave > 0 then
scratch = wave
scratch -= 1
need = script_option[Option.tier_step_waves]
scratch /= need
if scratch > 3 then scratch = 3 end
if scratch > unlock then unlock = scratch end
end

for each player do
class = current_player.get_deployment_class()
ok = 0
if current_player.role == Role.survivor and not current_player.is_not_respawning() and class == -1 and phase != Phase.over then
need = current_player.perks
need &= Perk.ready
if need != 0 then
count = ZsClass.survivor
scratch = current_player.perks
scratch &= Perk.grenadier
if scratch != 0 then count = ZsClass.grenadier end
scratch = current_player.perks
scratch &= Perk.assault
if scratch != 0 and count == ZsClass.grenadier then count = ZsClass.assault_grenadier end
if scratch != 0 and count == ZsClass.survivor then count = ZsClass.assault end
scratch = current_player.deploy_class(count)
end
if need == 0 then ok = 2 end
end
scratch = current_player.get_respawn_time()
if current_player.role == Role.infected and not current_player.is_not_respawning() and class == -1 and scratch == 0 and phase != Phase.over then ok = 1 end
if ok == 1 and current_player.menu == Menu.closed then
current_player.menu = Menu.picker
current_player.set_ui_menu(true)
end
if ok == 2 and current_player.menu == Menu.closed then
current_player.menu = Menu.traits
current_player.set_ui_menu(true)
end
if ok != 1 and current_player.menu == Menu.picker then close_menu() end
if ok != 2 and current_player.menu == Menu.traits then close_menu() end
if current_player.menu == Menu.shop and not current_player.is_not_respawning() then close_menu() end
end

if quartermaster == no_object then
for each player do
if quartermaster == no_object and current_player.role == Role.survivor and current_player.is_not_respawning() then
quartermaster = current_player.biped.place_at_me(marine, "zs_qm", never_garbage_collect, 20, 0, 0, none)
quartermaster.copy_rotation_from(current_player.biped, false)
quartermaster.set_invincibility(true)
quartermaster.set_garbage_collection_disabled(true)
end
end
end

for each object do
if current_object.is_of_type(grav_lift) then current_object.age += 1 end
if current_object.has_forge_label("zs_leap") then
current_object.age += 1
if current_object.age >= 60 then current_object.delete() end
end
if current_object.is_of_type(weapon) and not current_object.has_forge_label("zs_gun") and not current_object.has_forge_label("zs_leap") then
ok = 1
holder = current_object.get_carrier()
if holder != no_player then
ok = 0
current_object.held = 1
end
if ok == 1 and current_object.held == 1 then
for each player do
if current_player.is_not_respawning() then
scratch = current_player.biped.get_distance_to(current_object)
if scratch < 6 then ok = 0 end
end
end
end
if ok == 1 then current_object.delete() end
end
end
for each player do
if current_player.pending > 0 and current_player.is_not_respawning() then
if current_player.tool == no_object and not current_player.watch.is_zero() then
made = no_object
limit = 100000
for each object do
if current_object.is_of_type(grav_lift) and current_object.claimed == 0 and current_object.age < 90 then
scratch = current_object.get_distance_to(current_player.biped)
if scratch < limit then
limit = scratch
made = current_object
end
end
end
if made != no_object then
made.claimed = 1
current_player.tool = made
end
end
if current_player.tool != no_object then
scratch = current_player.tool.get_speed()
count = current_player.tool.age
if scratch == 0 and count >= 5 then place_object() end
end
if current_player.carrying.is_zero() and current_player.watch.is_zero() and current_player.tool == no_object and current_player.pending > 0 then
current_player.give_equipment(grav_lift)
current_player.carrying = 1
end
end
end

seconds = phase_timer
open_wave = wave
if phase == Phase.warmup then open_wave = 1 end
if phase == Phase.intermission then open_wave += 1 end
limit = script_option[Option.min_players]
if phase == Phase.warmup then
script_widget[0].set_text("WARMUP  |  outbreak in %n s", seconds)
if players < limit then script_widget[0].set_text("FLOOD SURVIVAL  |  waiting for %n players", limit) end
end
if phase == Phase.wave then
limit = script_option[Option.wave_count]
script_widget[0].set_text("WAVE %n / %n  |  %n s left", wave, limit, seconds)
end
if phase == Phase.intermission then
scratch = wave
scratch += 1
script_widget[0].set_text("BREAK  |  wave %n starts in %n s", scratch, seconds)
end
scratch = unlock
scratch += 1
script_widget[1].set_text("Survivors %n  |  Infected %n  |  Flood tier %n / 4", survivors, infected, scratch)
if survivors == 1 and phase >= Phase.wave then script_widget[1].set_text("LAST SURVIVOR STANDING  |  Infected %n  |  Flood tier %n / 4", infected, scratch) end
script_widget[0].set_visibility(all_players, true)
script_widget[1].set_visibility(all_players, true)
script_widget[6].set_visibility(all_players, true)

for each player do
script_widget[18].set_visibility(current_player, false)
if current_player.role == Role.survivor then
script_widget[2].set_text_for(current_player, "%n points", current_player.points)
limit = script_option[Option.free_shop]
if limit == 1 then script_widget[2].set_text_for(current_player, "%n points  |  test: FREE arsenal", current_player.points) end
scratch = current_player.perks
scratch &= Perk.awards
if scratch == Perk.free_gun then script_widget[2].set_text_for(current_player, "%n points  |  award: next weapon free", current_player.points) end
if scratch == Perk.free_gear then script_widget[2].set_text_for(current_player, "%n points  |  award: next placeable or equipment free", current_player.points) end
if scratch == Perk.awards then script_widget[2].set_text_for(current_player, "%n points  |  award: next weapon and next gear free", current_player.points) end
script_widget[3].set_text_for(current_player, "Ability 1: arsenal  |  Flashlight: pick up a prop")
if current_player.pending > 0 then script_widget[3].set_text_for(current_player, "Throw your grav lift to build it") end
if current_player.prop != no_object then script_widget[3].set_text_for(current_player, "Carrying a prop  |  Flashlight drops it") end
if current_player.pending == Item.prop then script_widget[3].set_text_for(current_player, "Carrying a prop  |  Flashlight drops it, or throw the grav lift") end
if phase == Phase.wave and quartermaster != no_object and current_player.is_not_respawning() then
scratch = current_player.biped.get_distance_to(quartermaster)
limit = script_option[Option.quartermaster_radius]
script_widget[18].set_text_for(current_player, "Quartermaster %n ft  |  arsenal within %n ft", scratch, limit)
script_widget[18].set_visibility(current_player, true)
end
end
if current_player.role == Role.infected then
script_widget[2].set_text_for(current_player, "Survivors converted: %n of %n", converted, total)
script_widget[3].set_text_for(current_player, "")
class = current_player.get_deployment_class()
if class == ZsClass.human or class == ZsClass.breacher or class == ZsClass.elite or class == ZsClass.brute or class == ZsClass.jumper_brute then script_widget[3].set_text_for(current_player, "Crouch: leap the way you face") end
if class == ZsClass.nest_stalker then
scratch = nest_wait
script_widget[3].set_text_for(current_player, "Nest Stalker  |  A1 build the nest (ready in %n s)", scratch)
if nest != no_object then script_widget[3].set_text_for(current_player, "Nest Stalker  |  your team's nest is standing") end
end
scratch = current_player.morph_wait
if class == ZsClass.shifter_stalker then script_widget[3].set_text_for(current_player, "Shifter Stalker  |  A1 turret, A2 Tank, again to change back (ready in %n s)", scratch) end
end
script_widget[2].set_visibility(current_player, true)
script_widget[3].set_visibility(current_player, true)
script_widget[22].set_visibility(current_player, false)
script_widget[23].set_visibility(current_player, false)
if current_player.biped != no_object then
scratch = current_player.biped.health
if scratch < 1 then scratch = 1 end
script_widget[23].set_text_for(current_player, "%n/100", scratch)
scratch *= 3
script_widget[22].set_size(current_player, scratch, 14)
script_widget[22].set_visibility(current_player, true)
script_widget[23].set_visibility(current_player, true)
end
hide_menu()
if current_player.menu == Menu.shop or current_player.menu == Menu.traits then
if current_player.menu == Menu.shop then draw_shop() end
if current_player.menu == Menu.traits then draw_traits() end
script_widget[4].set_visibility(current_player, true)
script_widget[5].set_visibility(current_player, true)
script_widget[7].set_visibility(current_player, true)
script_widget[8].set_visibility(current_player, true)
script_widget[9].set_visibility(current_player, true)
script_widget[10].set_visibility(current_player, true)
script_widget[11].set_visibility(current_player, true)
if current_player.menu == Menu.traits or current_player.page != 2 then
script_widget[12].set_visibility(current_player, true)
script_widget[13].set_visibility(current_player, true)
script_widget[14].set_visibility(current_player, true)
end
if current_player.menu == Menu.shop then
script_widget[15].set_visibility(current_player, true)
script_widget[16].set_visibility(current_player, true)
end
if current_player.menu == Menu.traits then script_widget[19].set_visibility(current_player, true) end
if current_player.menu == Menu.traits then
script_widget[21].set_text_for(current_player, "LAST SURVIVOR")
script_widget[21].set_visibility(current_player, true)
script_widget[27].set_text_for(current_player, "With one Survivor left, they get 2x health and shields that recharge twice as fast.")
script_widget[27].set_visibility(current_player, true)
script_widget[30].set_text_for(current_player, "They also never reload (bottomless mag), and everyone sees LAST SURVIVOR STANDING.")
script_widget[30].set_visibility(current_player, true)
script_widget[28].set_text_for(current_player, "WAVE AWARDS")
script_widget[28].set_visibility(current_player, true)
script_widget[29].set_text_for(current_player, "Most kills in a wave: your next weapon from the arsenal is free, any you like.")
script_widget[29].set_visibility(current_player, true)
script_widget[31].set_text_for(current_player, "Most props placed (the break before counts): next placeable or equipment free.")
script_widget[31].set_visibility(current_player, true)
end
if current_player.menu == Menu.shop then
script_widget[21].set_text_for(current_player, "BUILD A BASE")
script_widget[21].set_visibility(current_player, true)
script_widget[27].set_text_for(current_player, "Flashlight picks up the closest prop (8 ft). Press again to drop it: quick but rough.")
script_widget[27].set_visibility(current_player, true)
script_widget[30].set_text_for(current_player, "Prop Placer (20 points) is more accurate: buy one, pick up a prop, then throw the grav lift.")
script_widget[30].set_visibility(current_player, true)
script_widget[28].set_text_for(current_player, "THE ARSENAL")
script_widget[28].set_visibility(current_player, true)
script_widget[29].set_text_for(current_player, "Ability 1 opens it: near the quartermaster in waves, anywhere in warmup and breaks.")
script_widget[29].set_visibility(current_player, true)
script_widget[31].set_text_for(current_player, "Placeables come as a grav lift: throw it and it's built where it lands. All gear opens by wave.")
script_widget[31].set_visibility(current_player, true)
end
script_widget[17].set_visibility(current_player, true)
end
if current_player.menu == Menu.picker then
draw_picker()
script_widget[4].set_visibility(current_player, true)
script_widget[5].set_visibility(current_player, true)
script_widget[7].set_visibility(current_player, true)
script_widget[15].set_visibility(current_player, true)
if ok == 0 then
script_widget[8].set_visibility(current_player, true)
script_widget[9].set_visibility(current_player, true)
script_widget[10].set_visibility(current_player, true)
script_widget[11].set_visibility(current_player, true)
script_widget[12].set_visibility(current_player, true)
script_widget[13].set_visibility(current_player, true)
script_widget[14].set_visibility(current_player, true)
script_widget[19].set_visibility(current_player, true)
script_widget[24].set_visibility(current_player, true)
script_widget[25].set_visibility(current_player, true)
script_widget[26].set_visibility(current_player, true)
if current_player == boss and boss_used == 0 then script_widget[20].set_visibility(current_player, true) end
end
if nest != no_object then script_widget[16].set_visibility(current_player, true) end
script_widget[21].set_text_for(current_player, "BOSSES")
script_widget[21].set_visibility(current_player, true)
script_widget[27].set_text_for(current_player, "The Infected with the most kills picks a boss at the start of each wave.")
script_widget[27].set_visibility(current_player, true)
script_widget[30].set_text_for(current_player, "Bosses start in wave 2. Click the gold card to cycle through them.")
script_widget[30].set_visibility(current_player, true)
end
end
