-- Flood Survival. Compile with flood-survival-template.json (tools/build.ps1). Explanations: docs/how-the-script-works.md.

enum ZsClass
survivor = 0
human = 1
elite = 2
brute = 3
stalker = 4
monitor = 5
grenadier = 6
assault = 7
assault_grenadier = 8
nest_stalker = 9
shifter_stalker = 10
baby_stalker = 11
tank = 12
sword_spartan = 13
juggernaut = 14
brute_chieftain = 15
spartan_boss = 16
breacher = 17
jumper_brute = 18
invis_stalker = 19
end

enum Option
break_seconds = 0
free_shop = 1
gun_cap = 2
kill_points = 3
min_players = 4
placeable_limit = 5
quartermaster_radius = 6
start_infected_percent = 7
start_points = 8
test_keys = 9
tier_step_waves = 10
warmup_seconds = 11
wave1_seconds = 12
wave_bonus = 13
wave_count = 14
wave_increase_seconds = 15
end

enum Phase
warmup
wave
intermission
over
end

enum Role
arrival
survivor
infected
end

enum Menu
closed
shop
picker
traits
end

enum Perk
fast = 1
slow = 2
overshield = 4
frail = 8
hard_hitter = 16
weak_arm = 32
grenadier = 64
tough = 128
ready = 256
assault = 512
prop_placer = 1024
shift_tank = 2048
free_gun = 4096
free_gear = 8192
awards = 12288
end

enum Item
smg = 0
plasma_rifle = 1
battle_rifle = 2
carbine = 3
needler = 4
shotgun = 5
mauler = 6
brute_shot = 7
sniper_rifle = 8
beam_rifle = 9
energy_sword = 10
flamethrower = 11
gravity_hammer = 12
fuel_rod_gun = 13
rocket_launcher = 14
spartan_laser = 15
prop_placer = 16
wall = 17
turret = 18
plasma_cannon = 19
missile_pod = 20
ammo = 24
radar_jammer = 25
cover = 26
trip_mine = 27
regenerator = 28
bubble_shield = 29
active_camo = 30
invincibility = 31
prop = 32
end

alias phase = global.number[0]
alias wave = global.number[1]
alias unlock = global.number[2]
alias players = global.number[3]
alias survivors = global.number[4]
alias infected = global.number[5]
alias converted = global.number[6]
alias seconds = global.number[7]
alias avail = global.number[9]
alias open_wave = global.number[8]
alias boss_used = global.number[10]
alias last_alert = global.number[11]
alias quartermaster = global.object[0]
alias made = global.object[1]
alias nest = global.object[2]
alias holder = global.player[0]
alias boss = global.player[1]
alias top_killer = global.player[2]
alias top_builder = global.player[3]
alias phase_timer = global.timer[0]
alias purge_timer = global.timer[2]
alias nest_wait = global.timer[3]

alias class = temporaries.number[0]
alias scratch = temporaries.number[1]
alias item = temporaries.number[2]
alias price = temporaries.number[3]
alias count = temporaries.number[4]
alias ok = temporaries.number[5]
alias picks = temporaries.number[6]
alias total = temporaries.number[7]
alias need = temporaries.number[8]
alias limit = temporaries.number[9]
alias leap_r = temporaries.number[9]
alias leap_s = temporaries.number[4]
alias leap_d = temporaries.number[8]
alias leap_num = temporaries.number[3]
alias leap_den = temporaries.number[2]
alias leap_fwd = temporaries.number[6]
alias leap_up = temporaries.number[7]
alias leap_helper = temporaries.object[0]

alias role = player.number[0]
alias deaths = player.number[1]
alias kills = player.number[2]
alias points = player.number[3]
alias menu = player.number[4]
alias page = player.number[5]
alias pending = player.number[6]
alias swap = player.number[7]
alias tool = player.object[0]
alias morph_new = player.object[1]
alias morph_old = player.object[2]
alias prop = player.object[2]
alias form = player.number[3]
alias morph_wait = player.timer[0]
alias morph_delay = player.timer[2]
alias body = player.object[3]
alias buy_wait = player.timer[0]
alias carrying = player.timer[1]
alias watch = player.timer[2]
alias perks = player.timer[3]

alias age = object.number[0]
alias claimed = object.number[1]
alias held = object.number[2]
alias kept = object.number[3]
alias leap_state = object.number[5]
alias leap_ticks = object.number[6]
alias leap_cos = object.number[7]
alias leap_wait = object.timer[0]
alias prop_lock = object.timer[1]
alias prop_owner = object.player[0]
alias counted_wave = object.number[4]
alias wave_kills = object.number[5]
alias wave_props = object.number[6]
alias leap_origin = object.object[0]
alias leap_ahead = object.object[1]
alias leap_px = object.object[2]
alias leap_py = object.object[3]

