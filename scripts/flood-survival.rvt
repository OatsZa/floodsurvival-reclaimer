function start_wave()
scratch = wave
scratch -= 1
limit = script_option[Option.wave_increase_seconds]
scratch *= limit
limit = script_option[Option.wave1_seconds]
scratch += limit
phase_timer = scratch
phase_timer.set_rate(-100%)
phase = Phase.wave
end

function close_menu()
if current_player.menu != Menu.closed then current_player.set_ui_menu(false) end
current_player.menu = Menu.closed
end

function drop_prop()
if current_player.prop != no_object then current_player.prop.detach() end
current_player.prop = no_object
if current_player.pending == Item.prop then current_player.pending = 0 end
end

function leap_cosine()
if leap_r > 60 then
leap_r /= 2
leap_s /= 2
leap_d /= 2
end
if leap_r > 60 then
leap_r /= 2
leap_s /= 2
leap_d /= 2
end
leap_num = leap_s
leap_num *= leap_s
scratch = leap_r
scratch *= leap_r
leap_num += scratch
scratch = leap_d
scratch *= leap_d
leap_num -= scratch
leap_den = leap_s
leap_den *= leap_r
leap_den *= 2
leap_den /= 100
if leap_den < 1 then leap_den = 1 end
leap_num /= leap_den
if leap_num > 100 then leap_num = 100 end
if leap_num < -100 then leap_num = -100 end
end

function make_infected()
drop_prop()
close_menu()
current_player.role = Role.infected
current_player.pending = 0
current_player.form = 0
current_player.page = ZsClass.human
if current_player.is_not_respawning() then current_player.swap = 2 end
end

function open_shop()
ok = 0
if phase == Phase.warmup or phase == Phase.intermission then ok = 1 end
if phase == Phase.wave and quartermaster != no_object then
scratch = current_player.biped.get_distance_to(quartermaster)
limit = script_option[Option.quartermaster_radius]
if scratch <= limit then ok = 1 end
end
if current_player.menu != Menu.closed then ok = 0 end
if ok == 0 then script_widget[6].set_text_for(current_player, "Too far from the quartermaster") end
if ok == 1 then
current_player.menu = Menu.shop
current_player.set_ui_menu(true)
script_widget[6].set_text_for(current_player, "")
end
end

function find_price()
price = 0
if item == Item.smg then price = 15 end
if item == Item.plasma_rifle then price = 20 end
if item == Item.battle_rifle then price = 25 end
if item == Item.carbine then price = 25 end
if item == Item.needler then price = 25 end
if item == Item.shotgun then price = 35 end
if item == Item.mauler then price = 45 end
if item == Item.brute_shot then price = 60 end
if item == Item.sniper_rifle then price = 70 end
if item == Item.beam_rifle then price = 70 end
if item == Item.energy_sword then price = 90 end
if item == Item.flamethrower then price = 90 end
if item == Item.gravity_hammer then price = 90 end
if item == Item.fuel_rod_gun then price = 120 end
if item == Item.rocket_launcher then price = 130 end
if item == Item.spartan_laser then price = 150 end
if item == Item.prop_placer then price = 20 end
if item == Item.wall then price = 50 end
if item == Item.turret then price = 80 end
if item == Item.plasma_cannon then price = 110 end
if item == Item.missile_pod then price = 140 end
if item == Item.ammo then price = 20 end
if item == Item.radar_jammer then price = 15 end
if item == Item.cover then price = 25 end
if item == Item.trip_mine then price = 30 end
if item == Item.regenerator then price = 45 end
if item == Item.bubble_shield then price = 45 end
if item == Item.active_camo then price = 60 end
if item == Item.invincibility then price = 100 end
end

function item_wave()
need = 1
if item >= Item.mauler then need = 2 end
if item >= Item.energy_sword then need = 3 end
if item >= Item.fuel_rod_gun then need = 4 end
if item >= Item.spartan_laser then need = 5 end
if item >= Item.prop_placer then need = 1 end
if item >= Item.turret then need = 2 end
if item >= Item.plasma_cannon then need = 3 end
if item >= Item.missile_pod then need = 4 end
if item >= Item.ammo then need = 1 end
if item >= Item.trip_mine then need = 2 end
if item >= Item.active_camo then need = 3 end
if item >= Item.invincibility then need = 4 end
end

function check_map()
need = 0
if item == Item.plasma_cannon then need = 1 end
if item == Item.missile_pod then need = 2 end
count = 0
if need != 0 then
scratch = avail
scratch &= need
if scratch == 0 then count = 1 end
end
end

function buy()
find_price()
ok = 1
scratch = script_option[Option.free_shop]
if scratch == 1 then price = 0 end
picks = 0
scratch = current_player.perks
scratch &= Perk.free_gun
if scratch != 0 and item <= Item.spartan_laser then picks = Perk.free_gun end
scratch = current_player.perks
scratch &= Perk.free_gear
if scratch != 0 and item >= Item.prop_placer and item != Item.ammo then picks = Perk.free_gear end
if picks != 0 then price = 0 end
if current_player.points < price then
ok = 0
script_widget[6].set_text_for(current_player, "Not enough points: that costs %n", price)
end
if not current_player.buy_wait.is_zero() then
ok = 0
script_widget[6].set_text_for(current_player, "One purchase a second")
end
scratch = current_player.perks
scratch &= Perk.prop_placer
if item >= Item.prop_placer and item != Item.ammo then
if not current_player.carrying.is_zero() or current_player.pending > 0 or scratch != 0 then
ok = 0
script_widget[6].set_text_for(current_player, "Use what you carry first")
end
end
item_wave()
if need > open_wave then
ok = 0
script_widget[6].set_text_for(current_player, "That opens in wave %n", need)
end
if item == Item.prop_placer and scratch != 0 then
ok = 0
script_widget[6].set_text_for(current_player, "You already have a Prop Placer ready")
end
check_map()
if count == 1 then
ok = 0
script_widget[6].set_text_for(current_player, "This map doesn't have that")
end
if item <= Item.spartan_laser then
count = 0
for each object with label "zs_gun" do count += 1 end
limit = script_option[Option.gun_cap]
if count >= limit then
ok = 0
script_widget[6].set_text_for(current_player, "Too many guns on the ground: pick some up")
end
end
if ok == 1 then
current_player.points -= price
current_player.buy_wait = 1
current_player.buy_wait.set_rate(-100%)
script_widget[6].set_text_for(current_player, "Bought")
if picks != 0 then
scratch = current_player.perks
scratch ~= picks
current_player.perks = scratch
script_widget[6].set_text_for(current_player, "Bought with your wave award")
end
if item == Item.shotgun then made = current_player.biped.place_at_me(shotgun, "zs_gun", none, 5, 0, 3, none) end
if item == Item.battle_rifle then made = current_player.biped.place_at_me(battle_rifle, "zs_gun", none, 5, 0, 3, none) end
if item == Item.smg then made = current_player.biped.place_at_me(smg, "zs_gun", none, 5, 0, 3, none) end
if item == Item.sniper_rifle then made = current_player.biped.place_at_me(sniper_rifle, "zs_gun", none, 5, 0, 3, none) end
if item == Item.rocket_launcher then made = current_player.biped.place_at_me(rocket_launcher, "zs_gun", none, 5, 0, 3, none) end
if item == Item.carbine then made = current_player.biped.place_at_me(carbine, "zs_gun", none, 5, 0, 3, none) end
if item == Item.mauler then made = current_player.biped.place_at_me(mauler, "zs_gun", none, 5, 0, 3, none) end
if item == Item.energy_sword then made = current_player.biped.place_at_me(energy_sword, "zs_gun", none, 5, 0, 3, none) end
if item == Item.flamethrower then made = current_player.biped.place_at_me(flamethrower, "zs_gun", none, 5, 0, 3, none) end
if item == Item.spartan_laser then made = current_player.biped.place_at_me(spartan_laser, "zs_gun", none, 5, 0, 3, none) end
if item == Item.brute_shot then made = current_player.biped.place_at_me(brute_shot, "zs_gun", none, 5, 0, 3, none) end
if item == Item.gravity_hammer then made = current_player.biped.place_at_me(gravity_hammer, "zs_gun", none, 5, 0, 3, none) end
if item == Item.needler then made = current_player.biped.place_at_me(needler, "zs_gun", none, 5, 0, 3, none) end
if item == Item.plasma_rifle then made = current_player.biped.place_at_me(plasma_rifle, "zs_gun", none, 5, 0, 3, none) end
if item == Item.beam_rifle then made = current_player.biped.place_at_me(beam_rifle, "zs_gun", none, 5, 0, 3, none) end
if item == Item.fuel_rod_gun then made = current_player.biped.place_at_me(fuel_rod_gun, "zs_gun", none, 5, 0, 3, none) end
if item == Item.ammo then current_player.refill_ammo() end
if item == Item.cover then current_player.give_equipment(deployable_cover) end
if item == Item.bubble_shield then current_player.give_equipment(bubble_shield) end
if item == Item.regenerator then current_player.give_equipment(regenerator) end
if item == Item.trip_mine then current_player.give_equipment(trip_mine) end
if item == Item.radar_jammer then current_player.give_equipment(radar_jammer) end
if item == Item.active_camo then current_player.give_equipment(active_camo) end
if item == Item.invincibility then current_player.give_equipment(invincibility) end
if item >= Item.radar_jammer and item <= Item.invincibility then current_player.carrying = 1 end
if item == Item.prop_placer then
scratch = current_player.perks
scratch |= Perk.prop_placer
current_player.perks = scratch
script_widget[6].set_text_for(current_player, "Bought: your next prop comes with a grav lift to throw it")
if current_player.prop != no_object then
current_player.pending = Item.prop
current_player.give_equipment(grav_lift)
current_player.carrying = 1
end
end
if item >= Item.wall and item <= Item.missile_pod then
current_player.pending = item
current_player.give_equipment(grav_lift)
current_player.carrying = 1
end
end
end

