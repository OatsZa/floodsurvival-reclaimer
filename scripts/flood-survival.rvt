function form_need()
need = 0
if class == ZsClass.brute or class == ZsClass.stalker or class == ZsClass.jumper_brute then need = 1 end
if class == ZsClass.elite or class == ZsClass.nest_stalker or class == ZsClass.invis_stalker then need = 2 end
if class == ZsClass.shifter_stalker or class == ZsClass.tank then need = 3 end
end

function pick_form()
class = current_player.page
if class < ZsClass.human or class > ZsClass.invis_stalker then class = ZsClass.human end
if class > ZsClass.stalker and class < ZsClass.nest_stalker then class = ZsClass.human end
scratch = 0
if class >= ZsClass.juggernaut and class <= ZsClass.spartan_boss then scratch = 1 end
if scratch == 1 then
if current_player != boss or boss_used == 1 then class = ZsClass.human end
end
ok = 0
scratch = phase_timer
if phase == Phase.intermission and scratch > 6 then ok = 1 end
if ok == 1 then class = ZsClass.monitor end
end

function spawn_form()
pick_form()
form_need()
count = 1
if unlock < need then count = 0 end
limit = script_option[Option.wave_count]
if class == ZsClass.sword_spartan then
if phase != Phase.wave or wave < limit then count = 0 end
end
if count == 0 then script_widget[6].set_text_for(current_player, "Still locked") end
if count == 1 then
count = current_player.deploy_class(class)
if count == 0 then script_widget[6].set_text_for(current_player, "Can't take that form now") end
if count == 1 then script_widget[6].set_text_for(current_player, "") end
need = 0
if class >= ZsClass.juggernaut and class <= ZsClass.spartan_boss then need = 1 end
if count == 1 and need == 1 then
boss_used = 1
card_rows()
end
end
end

